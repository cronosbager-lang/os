[Unit]
Description=MIXOS First Boot Configuration
Documentation=https://mixos.dev/docs/firstboot
After=local-fs.target
Before=network.target
ConditionPathExists=!/var/lib/mixos/.firstboot-done

[Service]
Type=oneshot
RemainAfterExit=yes

ExecStart=/opt/mixos/scripts/firstboot.sh
ExecStartPost=/usr/bin/touch /var/lib/mixos/.firstboot-done

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mixos-firstboot

[Install]
WantedBy=multi-user.target
