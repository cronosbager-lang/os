#!/bin/bash
# MIXOS AI Hook - AI agent for early boot

build() {
    # Add AI agent binary
    if [[ -f /opt/mixos/bin/mix-agent-early ]]; then
        add_binary /opt/mixos/bin/mix-agent-early
    fi
    
    # Add AI model (quantized for early boot)
    if [[ -f /opt/mixos/ai/model/mix-early.gguf ]]; then
        add_file /opt/mixos/ai/model/mix-early.gguf
    elif [[ -f /opt/mixos/ai/model/mix-small-1.1b-q4.gguf ]]; then
        add_file /opt/mixos/ai/model/mix-small-1.1b-q4.gguf
    fi
    
    # Add AI prompts
    add_dir /opt/mixos/ai/prompts
    for prompt in /opt/mixos/ai/prompts/*.txt; do
        [[ -f "$prompt" ]] && add_file "$prompt"
    done
    
    # Add AI tools
    add_dir /opt/mixos/ai/tools
    for tool in /opt/mixos/ai/tools/*.sh; do
        [[ -f "$tool" ]] && add_file "$tool"
    done
    
    # Add configuration
    add_file /etc/mixos/ai-early.conf
    
    # Add runscript
    add_runscript
}

run() {
    # Check if AI agent should run
    if [[ -f /opt/mixos/bin/mix-agent-early ]]; then
        # Check for AI boot flag
        if grep -q "mixos.ai=1" /proc/cmdline || grep -q "mixos.ai=auto" /proc/cmdline; then
            msg "Starting MIXOS AI Early Agent..."
            
            # Start AI agent in background
            /opt/mixos/bin/mix-agent-early --daemon &
            AI_PID=$!
            
            # Wait briefly for initialization
            sleep 1
            
            # Check if running
            if kill -0 $AI_PID 2>/dev/null; then
                msg "AI Agent started (PID: $AI_PID)"
                echo $AI_PID > /run/mixos-ai.pid
            else
                msg "AI Agent failed to start"
            fi
        fi
    fi
}

help() {
    cat <<HELPEOF
This hook provides AI assistance during early boot:
- Loads the MIXOS AI early agent
- Includes quantized AI model for boot assistance
- Provides AI-powered hardware detection
- Assists with boot troubleshooting

Kernel parameters:
  mixos.ai=1     - Enable AI agent
  mixos.ai=auto  - Auto-detect if AI should run
  mixos.ai=0     - Disable AI agent
HELPEOF
}
