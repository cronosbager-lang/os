#!/bin/busybox sh
# MIXOS Initramfs Init Script
# This is the first userspace program (PID 1) in early boot

# Mount essential filesystems
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mkdir -p /dev/pts
mount -t devpts none /dev/pts
mkdir -p /run
mount -t tmpfs none /run

# Enable kernel messages
echo 1 > /proc/sys/kernel/printk

echo "=========================================="
echo "MIXOS GO Early Boot"
echo "=========================================="

# Create device nodes if devtmpfs didn't
[ -e /dev/null ] || mknod /dev/null c 1 3
[ -e /dev/console ] || mknod /dev/console c 5 1
[ -e /dev/tty ] || mknod /dev/tty c 5 0

# Parse kernel command line
CMDLINE=$(cat /proc/cmdline)
ROOT=""
INIT="/sbin/init"

for param in $CMDLINE; do
    case "$param" in
        root=*)
            ROOT="${param#root=}"
            ;;
        init=*)
            INIT="${param#init=}"
            ;;
        debug)
            set -x
            ;;
    esac
done

echo "[init] Root device: $ROOT"

# Run AI-guided hardware detection
if [ -x /usr/bin/mix-agent-early ]; then
    echo "[init] Starting AI-guided boot..."
    /usr/bin/mix-agent-early init
    AI_RESULT=$?
    
    if [ $AI_RESULT -ne 0 ]; then
        echo "[init] AI boot failed, falling back to manual boot"
    fi
else
    echo "[init] AI agent not found, using standard boot"
    
    # Load essential modules manually
    echo "[init] Loading kernel modules..."
    for mod in ahci sd_mod nvme ext4 squashfs overlay usb_storage; do
        modprobe $mod 2>/dev/null || true
    done
fi

# Wait for devices to settle
echo "[init] Waiting for devices..."
sleep 2

# Find root filesystem if not specified
if [ -z "$ROOT" ]; then
    echo "[init] Searching for root filesystem..."
    
    # Try by label
    if [ -e /dev/disk/by-label/MIXOS_ROOT ]; then
        ROOT="/dev/disk/by-label/MIXOS_ROOT"
    # Try common devices
    elif [ -e /dev/sda2 ]; then
        ROOT="/dev/sda2"
    elif [ -e /dev/vda2 ]; then
        ROOT="/dev/vda2"
    elif [ -e /dev/nvme0n1p2 ]; then
        ROOT="/dev/nvme0n1p2"
    fi
fi

if [ -z "$ROOT" ]; then
    echo "[init] ERROR: Cannot find root filesystem!"
    echo "[init] Dropping to emergency shell..."
    exec /bin/sh
fi

# Resolve symlinks
if [ -L "$ROOT" ]; then
    ROOT=$(readlink -f "$ROOT")
fi

echo "[init] Mounting root filesystem: $ROOT"

# Create mount point
mkdir -p /newroot

# Try to mount root filesystem
mount_success=0
for fstype in ext4 btrfs xfs; do
    if mount -t $fstype -o ro "$ROOT" /newroot 2>/dev/null; then
        mount_success=1
        echo "[init] Mounted as $fstype"
        break
    fi
done

if [ $mount_success -eq 0 ]; then
    # Try without specifying type
    if mount -o ro "$ROOT" /newroot 2>/dev/null; then
        mount_success=1
        echo "[init] Mounted (auto-detected type)"
    fi
fi

if [ $mount_success -eq 0 ]; then
    echo "[init] ERROR: Failed to mount root filesystem!"
    echo "[init] Dropping to emergency shell..."
    exec /bin/sh
fi

# Validate root filesystem
if [ ! -x "/newroot$INIT" ]; then
    echo "[init] ERROR: $INIT not found in root filesystem!"
    echo "[init] Dropping to emergency shell..."
    exec /bin/sh
fi

echo "[init] Root filesystem validated"

# Move mounts to new root
mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /run /newroot/run

echo "[init] Switching to real root..."
echo "=========================================="

# Switch root
exec switch_root /newroot "$INIT"

# If switch_root fails
echo "[init] ERROR: switch_root failed!"
exec /bin/sh
