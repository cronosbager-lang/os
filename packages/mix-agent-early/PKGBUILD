# PKGBUILD for mix-agent-early
# MIXOS Early Boot AI Agent (static binary for initramfs)

pkgname=mix-agent-early
pkgver=1.0.0
pkgrel=1
pkgdesc="MIXOS Early Boot AI Agent (static binary)"
arch=('x86_64')
url="https://mixos.dev"
license=('MIT')
depends=()  # No dependencies - static binary
makedepends=('go>=1.21')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    
    export CGO_ENABLED=0
    export GOOS=linux
    export GOARCH=amd64
    
    go build -ldflags="-s -w -extldflags '-static'" -o mix-agent-early .
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    
    # Install binary
    install -Dm755 mix-agent-early "$pkgdir/usr/bin/mix-agent-early"
}
