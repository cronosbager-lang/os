# PKGBUILD for mix-agent
# MIXOS AI Agent

pkgname=mix-agent
pkgver=1.0.0
pkgrel=1
pkgdesc="MIXOS AI Agent with llama.cpp integration"
arch=('x86_64')
url="https://mixos.dev"
license=('MIT')
depends=('python>=3.11' 'python-pip')
makedepends=('python-build' 'python-installer' 'python-wheel')
optdepends=(
    'cuda: GPU acceleration'
    'rocm: AMD GPU acceleration'
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    
    # Install Python package
    python -m installer --destdir="$pkgdir" dist/*.whl
    
    # Install configuration
    install -Dm644 config/agent.toml "$pkgdir/etc/mixos/agent.toml"
    
    # Install systemd service
    install -Dm644 systemd/mixos-agent.service "$pkgdir/usr/lib/systemd/system/mixos-agent.service"
    
    # Create directories
    install -dm755 "$pkgdir/opt/mixos/ai/model"
    install -dm755 "$pkgdir/var/lib/mixos/agent"
    install -dm755 "$pkgdir/var/log/mixos"
}

post_install() {
    echo "=========================================="
    echo "MIXOS AI Agent installed!"
    echo ""
    echo "To start the agent:"
    echo "  systemctl enable --now mixos-agent"
    echo ""
    echo "To download the AI model:"
    echo "  mix agent download-model"
    echo "=========================================="
}
