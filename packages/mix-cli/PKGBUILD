# PKGBUILD for mix-cli
# MIXOS Command Line Interface

pkgname=mix-cli
pkgver=1.0.0
pkgrel=1
pkgdesc="MIXOS Command Line Interface"
arch=('x86_64')
url="https://mixos.dev"
license=('MIT')
depends=('glibc')
makedepends=('go>=1.21')
provides=('mix')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    
    export CGO_ENABLED=0
    export GOOS=linux
    export GOARCH=amd64
    
    go build -ldflags="-s -w -X main.Version=$pkgver" -o mix-cli .
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    
    # Install binary
    install -Dm755 mix-cli "$pkgdir/usr/local/bin/mix-cli"
    
    # Create symlink
    ln -sf mix-cli "$pkgdir/usr/local/bin/mix"
    
    # Install shell completions
    install -Dm644 completions/bash "$pkgdir/usr/share/bash-completion/completions/mix"
    install -Dm644 completions/zsh "$pkgdir/usr/share/zsh/site-functions/_mix"
    install -Dm644 completions/fish "$pkgdir/usr/share/fish/vendor_completions.d/mix.fish"
}
