# PKGBUILD for mix-installer
# MIXOS TUI Installer

pkgname=mix-installer
pkgver=1.0.0
pkgrel=1
pkgdesc="MIXOS TUI Installer with AI assistance"
arch=('x86_64')
url="https://mixos.dev"
license=('MIT')
depends=('glibc')
makedepends=('go>=1.21')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    
    export CGO_ENABLED=0
    export GOOS=linux
    export GOARCH=amd64
    
    go build -ldflags="-s -w" -o mix-installer .
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    
    # Install binary
    install -Dm755 mix-installer "$pkgdir/usr/local/bin/mix-installer"
}
